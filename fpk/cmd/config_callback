#!/bin/bash

# 更新 Docker Compose 读取的 .env 环境变量文件
ENV_FILE="${TRIM_APPDEST}/docker/.env"
[ -z "$TRIM_APPDEST" ] && TRIM_APPDEST="/vol1/@appcenter/teleagent"
VOLUME_ROOT="${TRIM_APPDEST%%/@appcenter*}"
[ -z "$VOLUME_ROOT" ] && VOLUME_ROOT="/vol1"
WORKSPACE_HOST="${VOLUME_ROOT}/@appshare/teleagent/workspace"

PORT="${wizard_port:-5800}"

cat <<EOF > "$ENV_FILE"
PORT=$PORT
WORKSPACE_PATH=$WORKSPACE_HOST
EOF

chmod 644 "$ENV_FILE"

# 同步更新桌面快捷方式中的访问端口
if [ -f "${TRIM_APPDEST}/ui/config" ]; then
    sed -i "s/\"port\": \"[0-9]*\"/\"port\": \"$PORT\"/g" "${TRIM_APPDEST}/ui/config" 2>/dev/null || true
fi

exit 0