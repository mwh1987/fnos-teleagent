#!/bin/bash

# 更新 Docker Compose 读取的 .env 环境变量文件
ENV_FILE="${TRIM_APPDEST}/docker/.env"

PARENT_NIC="${wizard_parent_nic:-eth0}"
SUBNET="${wizard_subnet:-192.168.1.0/24}"
GATEWAY="${wizard_gateway:-192.168.1.1}"
STATIC_IP="${wizard_ip:-192.168.1.188}"
PORT="${wizard_port:-5800}"

cat <<EOF > "$ENV_FILE"
PARENT_NIC=$PARENT_NIC
SUBNET=$SUBNET
GATEWAY=$GATEWAY
STATIC_IP=$STATIC_IP
PORT=$PORT
EOF

chmod 644 "$ENV_FILE"

exit 0