#!/bin/bash
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH"

# 生成 Docker Compose 读取的 .env 环境变量文件
ENV_FILE="${TRIM_APPDEST}/docker/.env"

PARENT_NIC="${wizard_parent_nic:-eth0}"
SUBNET="${wizard_subnet:-192.168.1.0/24}"
GATEWAY="${wizard_gateway:-192.168.1.1}"
STATIC_IP="${wizard_ip:-192.168.1.188}"
PORT="${wizard_port:-5800}"

cat <<EOF > "$ENV_FILE"
PARENT_NIC=$PARENT_NIC
SUBNET=$SUBNET
GATEWAY=$GATEWAY
STATIC_IP=$STATIC_IP
PORT=$PORT
EOF

chmod 644 "$ENV_FILE"

# 离线自动载入 Docker 镜像（支持无网/弱网离线部署）
IMAGE_FILE="${TRIM_APPDEST}/image.tar.gz"
if [ -f "$IMAGE_FILE" ]; then
    gzip -dc "$IMAGE_FILE" | docker load
    rm -f "$IMAGE_FILE"
fi

exit 0